        { "name": "keepEnd", "label": "Keep at end", "type": "integer", "required": false, "defaultValue": 0, "min": 0, "max": null, "options": null }
      ]
    },
    {
      "id": "base64encode",
      "label": "Base64 encode",
      "description": "Encodes the text as Base64, from its UTF-8 bytes.",
      "fields": [
        { "name": "urlSafe", "label": "URL-safe alphabet", "type": "boolean", "required": false, "defaultValue": false, "min": null, "max": null, "options": null }
      ]
    },
    {
      "id": "base64decode",
      "label": "Base64 decode",
      "description": "Decodes Base64 back to text, read as UTF-8.",
      "fields": [
        { "name": "urlSafe", "label": "URL-safe alphabet", "type": "boolean", "required": false, "defaultValue": false, "min": null, "max": null, "options": null }
      ]
    }
