      "label": "Replace",
      "description": "Replaces every occurrence of some text with other text.",
      "fields": [
        { "name": "search", "label": "Search", "type": "text", "required": true, "defaultValue": null, "min": null, "max": null, "options": null },
        { "name": "replacement", "label": "Replacement", "type": "text", "required": false, "defaultValue": "", "min": null, "max": null, "options": null }
      ]
    },
    {
      "id": "append",
      "label": "Append",
      "description": "Adds text to the end.",
      "fields": [
        { "name": "text", "label": "Text", "type": "text", "required": false, "defaultValue": "", "min": null, "max": null, "options": null }
      ]
    },
    {
      "id": "prepend",
      "label": "Prepend",
      "description": "Adds text to the start.",
      "fields": [
        { "name": "text", "label": "Text", "type": "text", "required": false, "defaultValue": "", "min": null, "max": null, "options": null }
      ]
    },
    {
