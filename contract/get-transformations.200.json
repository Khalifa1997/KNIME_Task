      ]
    },
    {
      "id": "regex",
      "label": "Regex replace",
      "description": "Replaces every match of a regular expression.",
      "fields": [
        { "name": "pattern", "label": "Pattern", "type": "text", "required": true, "defaultValue": null, "min": null, "max": null, "options": null },
        { "name": "replacement", "label": "Replacement", "type": "text", "required": false, "defaultValue": "", "min": null, "max": null, "options": null },
        { "name": "ignoreCase", "label": "Ignore case", "type": "boolean", "required": false, "defaultValue": false, "min": null, "max": null, "options": null }
      ]
    },
    { "id": "uppercase", "label": "Uppercase", "description": "Converts the text to upper case.", "fields": [] },
    { "id": "lowercase", "label": "Lowercase", "description": "Converts the text to lower case.", "fields": [] },
    { "id": "reverse", "label": "Reverse", "description": "Reverses the order of the characters.", "fields": [] },
    {
