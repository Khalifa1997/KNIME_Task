<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.khalifa1997</groupId>
    <artifactId>text-transformer</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>text-transformer-app</artifactId>
  <name>Text Transformer app</name>
  <description>The Spring Boot web API, serving the built frontend.</description>

  <properties>
    <spring-boot.run.skip>false</spring-boot.run.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.khalifa1997</groupId>
      <artifactId>text-transformer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.khalifa1997</groupId>
      <artifactId>text-transformer-frontend</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <!-- The shared contract fixtures: the example JSON both sides are tested against. -->
      <testResource>
        <directory>${project.basedir}/../contract</directory>
        <targetPath>contract</targetPath>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
