{
  "name": "text-transformer-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.{css,vue}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@xyflow/vue": "2.0.0-next.18",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24"
  }
}
